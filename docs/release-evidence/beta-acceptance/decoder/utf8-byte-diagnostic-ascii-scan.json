    "nonAscii": "/[^\\x00-\\x7f]/",
    "current": "function current(text,limit) {\n   if(text.length>limit)return false;\n   const target=new Uint8Array(Math.min(limit,text.length*3));\n   return encoder.encodeInto(text,target).read===text.length;\n  }",
    "candidateBytes": "function candidateBytes(text,limit) {\n   if(text.length>limit)return -1;\n   if(!nonAscii.test(text))return text.length;\n   let bytes=text.length;\n   for(let i=0;i<text.length;i++) {\n    const code=text.charCodeAt(i);\n    if(code>=0x80) {\n     if(code<0x800)bytes++;\n     else {\n      bytes+=2;\n      if(code>=0xd800&&code<=0xdbff) {\n       const next=text.charCodeAt(i+1);\n       if(next>=0xdc00&&next<=0xdfff)i++;\n      }\n     }\n     if(bytes>limit)return -1;\n    }\n   }\n   return bytes;\n  }",
    "candidate": "function candidate(text,limit){return candidateBytes(text,limit)>=0;}"
