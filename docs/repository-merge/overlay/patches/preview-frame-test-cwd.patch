+/**
+ * Run `fn` with `dir` as the working directory. Since the repository merge
+ * (FORMA-113) this package sits in a workspace whose root installs
+ * @getforma/core, so "none is installed where the build runs" holds only from
+ * a directory outside it: the fixture's own, as an application's would be.
+ */
+async function from<T>(dir: string, fn: () => Promise<T>): Promise<T> {
+  const previous = process.cwd();
+  process.chdir(dir);
+  try {
+    return await fn();
+  } finally {
+    process.chdir(previous);
+  }
+}
