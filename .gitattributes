# FMIR fixtures are byte-exact output of the TypeScript compiler. Git's text
# heuristic plus core.autocrlf would rewrite any 0x0D 0x0A pair inside them on
# checkout, and the cross-implementation contract test would then be reading a
# corrupted binary rather than what the compiler emitted.
*.ir binary

# The goldens next to them are compared after newline normalization, but
# pinning LF keeps the committed bytes — and therefore every diff — identical
# on Windows and Linux.
crates/forma-ir/tests/fixtures/js-emitter/*.html text eol=lf

# forma-server's asset-set fixtures are compared byte-for-byte against the
# response body, so checkout must never rewrite their line endings.
crates/forma-server/tests/fixtures/asset-sets/** -text

# forma-server's 0.2.1 document goldens are compared byte-for-byte against
# `render_page`'s output, so checkout must never rewrite their line endings.
crates/forma-server/tests/fixtures/documents-0.2.1/** -text

# forma-server's module-loader fixtures are pinned byte-for-byte to the code
# that writes them (tests/strict_loader.rs), manifests included.
crates/forma-server/tests/fixtures/modules/** -text

# forma-server's preview-frame fixtures are inlined and hashed byte-for-byte,
# and one of them holds a carriage return on purpose (FRAME-103), so checkout
# must never rewrite their line endings.
crates/forma-server/tests/fixtures/frame/** -text

# The 0.3.0 worker fixtures are compared byte for byte with the generator's
# output (packages/build/tests/service-worker.test.ts), so checkout must never
# rewrite their line endings (Windows runners check text out with CRLF).
packages/build/tests/fixtures/** -text

# Canonical FMIR dumps compare byte-for-byte across Rust and TypeScript.
crates/forma-ir/tests/fixtures/js-emitter/*.dump text eol=lf
# The shared-constants checker deliberately compares generated bytes exactly.
packages/compiler/src/fmir-constants.ts text eol=lf
crates/forma-ir/src/fmir_constants.rs text eol=lf

# The island-emitter registration golden is compared byte-for-byte with the
# compiler's JSON.stringify output plus one LF
# (packages/compiler/tests/island-emission.test.ts), so checkout must keep its
# LF bytes on Windows too.
crates/forma-ir/tests/fixtures/island-emitter/*.json text eol=lf

# Packed candidates use the actual template source bytes on every platform.
packages/create-app/templates/*/src/main.rs text eol=lf
# Original source/doc bytes are authenticated by the migration archive index.
docs/archive/2026-10-15-template-slice1/** -text
# FORMA-181: archived originals and frozen keyed-list sources are authenticated by SHA-256.
docs/archive/2026-10-15-pre-keyed-rows/** -text
packages/compiler/tests/fixtures/keyed-lists/** -text
# FORMA-181: the archive test hashes the live list-same-source.state.json byte-for-byte.
crates/forma-ir/tests/fixtures/js-emitter/*.state.json text eol=lf
# FORMA-181: the archive test hashes the declared-props SRI manifest byte-for-byte.
crates/forma-server/tests/fixtures/props-contract/manifest.json text eol=lf
