{
  "schema": 1,
  "note": "The index of the fixture applications (FORMA-188). Each page is shaped after a consumer's page (element structure, island count, prop types, list sizes) and written new with neutral, synthetic labels, class names and values; none of it is taken from an application. `state` is the oracle: the values the handler serves, in wire names, which the spec compares with the page's state envelope.",
  "apps": {
    "ledger": {
      "css": "ledger/src/styles/app.css",
      "shapeSource": "shaped after a household finance app's arrival island: its signals, one conditional summary, a status line moved by the island's own request, a retry button",
      "routes": {
        "/household": {
          "page": "household",
          "entry": "ledger/src/household/app.tsx",
          "kind": "page",
          "propsType": "ArrivalProps",
          "propsFile": "ledger/src/household/arrival.tsx",
          "islands": [
            "HouseholdArrival"
          ],
          "state": {
            "HouseholdArrival": {
              "arrivalTitle": "Rivera household",
              "arrivalDate": "2026-09-13",
              "arrivalCash": "$12,345.67",
              "arrivalBills": "$34.00",
              "arrivalIncome": "$2,000.00",
              "arrivalStatus": "Loading",
              "arrivalSummary": true
            }
          },
          "serverValues": [
            {
              "selector": "#arrival-title",
              "text": "Rivera household"
            },
            {
              "selector": "#arrival-date",
              "text": "2026-09-13"
            },
            {
              "selector": "#arrival-cash",
              "text": "$12,345.67"
            },
            {
              "selector": "#arrival-bills",
              "text": "$34.00"
            },
            {
              "selector": "#arrival-income",
              "text": "$2,000.00"
            },
            {
              "selector": "#arrival-status",
              "text": "Loading"
            }
          ],
          "path": "/household"
        }
      }
    },
