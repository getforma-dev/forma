      "code": "BUILD-610",
      "message": "generic or namespace props types are not supported",
      "file": "negative/record-bindings/app.tsx",
      "why": "acceptance 4: a props type outside the closed type set (a map from control name to key list, the studio payload's wire type) fails the build with the declared-contract code, naming the file, line and column; the ksx fixture is its near miss"
    },
    {
      "name": "computed-condition",
      "entry": "negative/computed-condition/app.tsx",
      "fails": "diagnostic",
      "code": "BUILD-610",
      "message": "computed declared values remain outside the native subset",
      "file": "negative/computed-condition/app.tsx",
      "why": "the first construct the old tenant login used that 3.0.0 does not admit; the fixture passes a declared boolean instead"
    }
