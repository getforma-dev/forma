    { "id": "string-beyond-max-safe", "value": "9007199254740992", "expected": "9007199254740992", "served": "9007199254740992" },
    { "id": "html-chars-preserved", "value": "<&>\"'", "expected": "<&>\"'", "served": "&lt;&amp;&gt;&quot;'" },
    { "id": "whitespace-preserved", "value": "  a \t b  ", "expected": "  a \t b  ", "served": "  a \t b  " },
