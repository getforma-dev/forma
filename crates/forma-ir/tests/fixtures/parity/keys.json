{
  "title": "Canonical row identity for keyed lists (FORMA-181 checkpoint B, DR-8, v2 6.5 and 6.8)",
  "contract": "A list key is a string or a safe integer. A string key is written as N(s) of value rule 1 (normalization.json): CRLF and CR become LF, NUL becomes U+FFFD, nothing else changes. A number key must be an integer within plus or minus 2^53-1 and prints as its decimal integer; -0 prints as 0. null, booleans, arrays, objects, fractions, infinities and NaN are not identities: the native render refuses the page (RENDER-503) and core refuses the value (RangeError or TypeError). Two rows of one list execution whose canonical text is equal are duplicates. The path is read against the row's own fields only: every segment but the last names a field holding an object and the last names a field holding an identity; a missing field, a field declared twice or a non-object on the way refuses.",
  "consumers": [
    "crates/forma-ir/src/keys.rs tests: canonical_key_text over `values` and `collisions`, canonical_list_key over `paths` (JSON through json_to_slot_value)",
    "packages/core/src/dom/__tests__/key-text.test.ts: canonicalKeyText over `values` and `collisions`, a property read over `paths`"
  ],
  "note": "Hand-enumerated finite vectors; not a generator. A lone UTF-16 surrogate cannot be a vector: serde_json refuses the file and Rust strings cannot hold one, so core's unpaired-surrogate refusal is pinned in its own test only. JSON numbers are parsed exactly by both readers for every lexeme here: 9007199254740992 is 2^53 in both, and the float_roundtrip feature keeps 1.5 and 1e300 exact. -0 is a JSON lexeme both readers parse to negative zero.",
  "values": [
    { "id": "empty-string", "value": "", "expected": "" },
    { "id": "ascii", "value": "row-1", "expected": "row-1" },
    { "id": "unicode", "value": "Zoë ✓ 😀", "expected": "Zoë ✓ 😀" },
    { "id": "html-chars-preserved", "value": "<&>\"'", "expected": "<&>\"'" },
    { "id": "whitespace-preserved", "value": "  a \t b  ", "expected": "  a \t b  " },
    { "id": "lf-identity", "value": "a\nb", "expected": "a\nb" },
    { "id": "crlf", "value": "a\r\nb", "expected": "a\nb" },
    { "id": "cr", "value": "a\rb", "expected": "a\nb" },
    { "id": "trailing-cr", "value": "a\r", "expected": "a\n" },
    { "id": "nul", "value": "a\u0000b", "expected": "a�b" },
    { "id": "nul-only", "value": "\u0000", "expected": "�" },
    { "id": "replacement-identity", "value": "a�b", "expected": "a�b" },
    { "id": "string-zero-one", "value": "01", "expected": "01" },
    { "id": "string-one", "value": "1", "expected": "1" },
    { "id": "number-one", "value": 1, "expected": "1" },
    { "id": "number-one-point-zero", "value": 1.0, "expected": "1" },
    { "id": "zero", "value": 0, "expected": "0" },
    { "id": "negative-zero", "value": -0, "expected": "0" },
    { "id": "negative", "value": -42, "expected": "-42" },
    { "id": "max-safe", "value": 9007199254740991, "expected": "9007199254740991" },
    { "id": "min-safe", "value": -9007199254740991, "expected": "-9007199254740991" },
    { "id": "beyond-max-safe", "value": 9007199254740992, "refused": true },
    { "id": "beyond-min-safe", "value": -9007199254740992, "refused": true },
    { "id": "large-magnitude", "value": 1e300, "refused": true },
    { "id": "fraction", "value": 1.5, "refused": true },
    { "id": "small-fraction", "value": 0.1, "refused": true },
    { "id": "null", "value": null, "refused": true },
    { "id": "true", "value": true, "refused": true },
    { "id": "false", "value": false, "refused": true },
    { "id": "object", "value": { "id": 1 }, "refused": true },
    { "id": "empty-object", "value": {}, "refused": true },
    { "id": "array", "value": [1], "refused": true },
    { "id": "empty-array", "value": [], "refused": true }
  ],
  "collisions": [
    { "id": "number-and-string", "values": [1, "1"], "collide": true },
    { "id": "number-and-padded-string", "values": [1, "01"], "collide": false },
    { "id": "zero-and-negative-zero", "values": [0, -0], "collide": true },
    { "id": "zero-and-string-zero", "values": [0, "0"], "collide": true },
    { "id": "crlf-and-lf", "values": ["a\r\nb", "a\nb"], "collide": true },
    { "id": "cr-and-lf", "values": ["a\rb", "a\nb"], "collide": true },
    { "id": "nul-and-replacement", "values": ["\u0000", "�"], "collide": true },
    { "id": "case-is-identity", "values": ["A", "a"], "collide": false },
    { "id": "whitespace-is-identity", "values": ["a", "a "], "collide": false },
    { "id": "composed-and-decomposed", "values": ["é", "é"], "collide": false }
  ],
  "paths": [
    { "id": "direct", "row": { "id": 7 }, "path": ["id"], "expected": "7" },
    { "id": "direct-string", "row": { "id": "u1" }, "path": ["id"], "expected": "u1" },
    { "id": "nested", "row": { "user": { "id": "u1" } }, "path": ["user", "id"], "expected": "u1" },
    { "id": "nested-three", "row": { "a": { "b": { "c": 3 } } }, "path": ["a", "b", "c"], "expected": "3" },
    { "id": "extra-fields-ignored", "row": { "id": 1, "other": { "id": 2 } }, "path": ["id"], "expected": "1" },
    { "id": "missing-field", "row": { "name": "x" }, "path": ["id"], "refused": true },
    { "id": "missing-nested-field", "row": { "user": { "name": "x" } }, "path": ["user", "id"], "refused": true },
    { "id": "intermediate-not-object", "row": { "user": "u1" }, "path": ["user", "id"], "refused": true },
    { "id": "intermediate-null", "row": { "user": null }, "path": ["user", "id"], "refused": true },
    { "id": "intermediate-array", "row": { "user": [{ "id": 1 }] }, "path": ["user", "id"], "refused": true },
    { "id": "row-not-object", "row": "u1", "path": ["id"], "refused": true },
    { "id": "leaf-object", "row": { "id": { "value": 1 } }, "path": ["id"], "refused": true },
    { "id": "leaf-null", "row": { "id": null }, "path": ["id"], "refused": true },
    { "id": "leaf-boolean", "row": { "id": true }, "path": ["id"], "refused": true },
    { "id": "leaf-fraction", "row": { "id": 1.5 }, "path": ["id"], "refused": true }
  ]
}
