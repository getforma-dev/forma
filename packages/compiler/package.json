{
  "name": "@getforma/compiler",
  "version": "3.1.0-rc.3",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Forma <victor@getforma.dev>",
  "homepage": "https://getforma.dev",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/subset.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "emit:corpus": "npm run build && node scripts/emit-corpus.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8"
  },
  "peerDependencies": {
    "esbuild": ">=0.17.0",
    "@getforma/core": "^3.1.0 || =3.1.0-rc.3"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getforma-dev/forma.git",
    "directory": "packages/compiler"
